# ============================================================
#  .htaccess — Sistema INVENTARIO
#  Ubicación: raíz del proyecto (mismo nivel que index.php)
# ============================================================

# ── Motor de reescritura ─────────────────────────────────────
Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ── Base del proyecto ────────────────────────────────────────
RewriteBase /INVENTARIO/

# ── Manejo de errores personalizados ────────────────────────
ErrorDocument 403 /INVENTARIO/index.php?error=403
ErrorDocument 404 /INVENTARIO/index.php?error=404

# ── 1. BLOQUEAR ACCESO DIRECTO A DIRECTORIOS SENSIBLES ───────
#    Ningún archivo dentro de estas carpetas es accesible
#    directamente desde el navegador, sin importar su extensión.
RewriteRule ^config/      - [F,L]
RewriteRule ^models/      - [F,L]
RewriteRule ^controllers/ - [F,L]
RewriteRule ^app/         - [F,L]
RewriteRule ^logs/        - [F,L]

# ── 2. BLOQUEAR ARCHIVOS PHP DIRECTOS (lista blanca mínima) ──
#    Solo index.php y login.php son accesibles como archivos
#    PHP directos. TODO lo demás (logout, register, etc.) debe
#    pasar por el front-controller: index.php?controller=...
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI}      \.php$
RewriteCond %{REQUEST_URI}      !^/INVENTARIO/index\.php$
RewriteCond %{REQUEST_URI}      !^/INVENTARIO/login\.php$
RewriteCond %{REQUEST_URI}      !^/INVENTARIO/views/layouts/403-view\.php$
RewriteCond %{REQUEST_URI}      !^/INVENTARIO/views/layouts/404-view\.php$
RewriteCond %{REQUEST_URI}      !^/INVENTARIO/views/layouts/405-view\.php$
RewriteRule ^                   - [F,L]

# ── 3. PASAR RECURSOS ESTÁTICOS DIRECTAMENTE ─────────────────
#    CSS, JS, imágenes, fuentes, etc. se sirven sin reescritura.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^                   - [L]

# ── 4. TODO LO DEMÁS → index.php (front-controller) ─────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$              index.php [QSA,L]

# ── 5. CABECERAS DE SEGURIDAD ────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options  "nosniff"
    Header set X-Frame-Options         "SAMEORIGIN"
    Header set X-XSS-Protection        "1; mode=block"
    Header set Referrer-Policy         "strict-origin-when-cross-origin"
</IfModule>

# ── 6. OCULTAR VERSIÓN DE PHP Y SERVIDOR ─────────────────────
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ── 7. CACHE PARA RECURSOS ESTÁTICOS ────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType image/png               "access plus 1 month"
    ExpiresByType image/jpg               "access plus 1 month"
    ExpiresByType image/jpeg              "access plus 1 month"
    ExpiresByType image/gif               "access plus 1 month"
    ExpiresByType image/svg+xml           "access plus 1 month"
    ExpiresByType application/x-font-ttf  "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# ── 8. CHARSET Y COMPRESIÓN ──────────────────────────────────
AddDefaultCharset UTF-8

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
